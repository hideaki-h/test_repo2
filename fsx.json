params=$(cat << EOF
{
  "FileSystemType": "WINDOWS",
  "StorageCapacity": 32,
  "StorageType": "SSD",
  "SubnetIds": [
    "subnet-A",
    "subnet-B"
  ],
  "SecurityGroupIds": [
    "sg-SG"
  ],
  "WindowsConfiguration": {
    "SelfManagedActiveDirectoryConfiguration": {
      "DomainName": "ad.internal",
      "OrganizationalUnitDistinguishedName": "OU=FSxOU,DC=ad,DC=internal",
      "FileSystemAdministratorsGroup": "FSxAdminGroup",
      "DnsIps": [
        "10.x.x.x"
      ],
      "UserName": "FSxServiceAccount",
      "Password": "xxxx"
    },
    "DeploymentType": "MULTI_AZ_1",
    "PreferredSubnetId": "subnet-A",
    "ThroughputCapacity": 32,
    "AutomaticBackupRetentionDays": 1,
    "AuditLogConfiguration": {
      "FileAccessAuditLogLevel": "DISABLED",
      "FileShareAccessAuditLogLevel": "DISABLED"
    },
    "DiskIopsConfiguration": {
      "Mode": "AUTOMATIC"
    }
  },
  "NetworkType": "IPV4"
}
EOF
)

aws fsx create-file-system --cli-input-json "$params"
